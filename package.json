{
  "name": "paperweave",
  "version": "1.0.0",
  "description": "面向教师本人的本地题库桌面应用：从原卷 PDF 录题、拆题打标签、审核入库，到检索选题、组卷、生成学生卷与教师答案卷 PDF 并打印。覆盖小学至高中全学科，离线可用，题库与数据全部保存在本机。",
  "private": true,
  "main": ".vite/build/main.cjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "test:e2e": "npm run package && playwright test",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwq0327/PaperWeave.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wwq0327/PaperWeave/issues"
  },
  "homepage": "https://github.com/wwq0327/PaperWeave#readme",
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "tests/unit",
    "tests/e2e",
    "*.config.ts",
    "*.config.mts",
    "tests/performance"
  ]
}
